# Required: a long random secret shared only by the communicator and engine.
ACCESS_API_KEY=replace-with-a-long-random-secret

# Defaults to ./data locally and /data inside this container.
DATA_DIR=data

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
DEFAULT_MODEL=google/gemini-3.7-flash
# Maximum time the terminal communicator waits for one API request.
PERRY_REQUEST_TIMEOUT_SECONDS=180

# Required only when enabling Google Calendar OAuth. The redirect URI must
# exactly match the URI registered in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT_SECONDS=30
# Generate once with: poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_API_TIMEOUT_SECONDS=30

# Optional shared Google calendars. Share each calendar with the service
# account's email as "See all event details". Link calendars to users through
# POST /integrations/google/calendars; links are stored per user.
GOOGLE_SERVICE_ACCOUNT_FILE=
